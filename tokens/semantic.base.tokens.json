{
  "$description": "Semantic tokens that do not change between themes. Named by purpose.",
  "size": {
    "$type": "dimension",
    "control": {
      "$description": "Heights of interactive controls. All exceed the WCAG 2.2 target-size minimum.",
      "sm": {
        "$value": {
          "value": 32,
          "unit": "px"
        }
      },
      "md": {
        "$value": {
          "value": 40,
          "unit": "px"
        }
      },
      "lg": {
        "$value": {
          "value": 48,
          "unit": "px"
        }
      }
    }
  },
  "shape": {
    "control": {
      "$value": "{radius.md}",
      "$description": "Corner radius of buttons and inputs."
    },
    "surface": {
      "$value": "{radius.lg}",
      "$description": "Corner radius of cards, callouts and panels."
    }
  },
  "border": {
    "$type": "dimension",
    "width": {
      "default": {
        "$value": {
          "value": 1,
          "unit": "px"
        }
      },
      "focus-ring": {
        "$value": {
          "value": 2,
          "unit": "px"
        },
        "$description": "Focus outline thickness. 2px meets WCAG 2.4.13 Focus Appearance."
      },
      "focus-offset": {
        "$value": {
          "value": 2,
          "unit": "px"
        }
      }
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": {
          "value": 100,
          "unit": "ms"
        }
      },
      "base": {
        "$value": {
          "value": 160,
          "unit": "ms"
        }
      },
      "slow": {
        "$value": {
          "value": 240,
          "unit": "ms"
        }
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": {
        "$value": [
          0.2,
          0,
          0,
          1
        ],
        "$description": "Default ease-out for UI state changes."
      }
    },
    "press-scale": {
      "$type": "number",
      "$value": 0.97,
      "$description": "Scale applied to a control while pressed."
    }
  },
  "measure": {
    "$type": "dimension",
    "prose": {
      "$value": {
        "value": 40,
        "unit": "rem"
      },
      "$description": "Maximum line length for body text (about 65 characters)."
    }
  }
}
